#!/usr/bin/env perl
use strict; use warnings; use FindBin qw($Bin); use lib '/usr/lib/sendmailanalyzer/lib'; use lib "$Bin/../lib"; use Getopt::Long; use SendmailAnalyzer::Config; use SendmailAnalyzer::Storage::SQLite;
my $config='/etc/sendmailanalyzer.conf'; my ($root,$db,$date,$host); GetOptions('config=s'=>\$config,'legacy=s'=>\$root,'db=s'=>\$db,'date=s'=>\$date,'host=s'=>\$host) or die "usage: sa10_reconcile --date YYYY-MM-DD --host HOST [--legacy DIR]\n";
die "--date YYYY-MM-DD required\n" if !$date || $date !~ /^(\d{4})-(\d{2})-(\d{2})$/; my($y,$m,$d)=($1,$2,$3); die "--host required\n" if !$host;
my $cfg=SendmailAnalyzer::Config->load($config); $root||=$cfg->{LEGACY_DATA_DIR}; $db||=$cfg->{DB_FILE}; my $dir="$root/$host/$y/$m/$d";
sub lines { my($f,$filter)=@_; return 0 if !-f $f; open my $fh,'<',$f or return 0; my $n=0; while(<$fh>){ next if $filter && !/$filter/i; $n++ if /\S/ } close $fh; return $n }
my %v9=(messages=>lines("$dir/senders.dat"),recipients=>lines("$dir/recipient.dat"),sent=>lines("$dir/recipient.dat",qr/:Sent(?:\s*)$/),spam=>lines("$dir/spam.dat"),virus=>lines("$dir/virus.dat"),dsn=>lines("$dir/dsn.dat"),auth=>lines("$dir/auth.dat"),rejected=>lines("$dir/rejected.dat"));
sub duplicate_lines { my($f)=@_; return 0 if !-f $f; open my $fh,'<',$f or return 0; my(%s,$n); while(<$fh>){ chomp; next if !/\S/; $n++; $s{$_}++ } close $fh; return $n-scalar(keys %s) } my $auth_dups=duplicate_lines("$dir/auth.dat");
my $s=SendmailAnalyzer::Storage::SQLite->new(file=>$db,readonly=>1); my $dbh=$s->dbh; my $like="$date%";
my %v10; my $legacy_envelopes=0+$dbh->selectrow_array("SELECT COUNT(*) FROM events WHERE timestamp LIKE ? AND source='legacy' AND type='envelope'",undef,$like); $v10{messages}=$legacy_envelopes || 0+$dbh->selectrow_array('SELECT COUNT(*) FROM messages WHERE first_seen LIKE ?',undef,$like); $v10{recipients}=0+$dbh->selectrow_array('SELECT COUNT(*) FROM recipients WHERE timestamp LIKE ?',undef,$like); $v10{sent}=0+$dbh->selectrow_array("SELECT COUNT(*) FROM recipients WHERE timestamp LIKE ? AND lower(status)='sent'",undef,$like); $v10{spam}=0+$dbh->selectrow_array('SELECT COUNT(*) FROM messages WHERE first_seen LIKE ? AND spam_detected=1',undef,$like); $v10{virus}=0+$dbh->selectrow_array("SELECT COUNT(*) FROM events WHERE timestamp LIKE ? AND type='virus_verdict'",undef,$like); $v10{dsn}=0+$dbh->selectrow_array("SELECT COUNT(*) FROM events WHERE timestamp LIKE ? AND type='dsn'",undef,$like); $v10{auth}=0+$dbh->selectrow_array("SELECT COUNT(*) FROM events WHERE timestamp LIKE ? AND type IN ('smtp_auth','tls')",undef,$like); $v10{rejected}=0+$dbh->selectrow_array("SELECT COUNT(*) FROM events WHERE timestamp LIKE ? AND type IN ('smtp_reject','dnsbl_reject')",undef,$like);
printf "Reconciliation %s / %s\n%-14s %10s %10s %10s\n",$host,$date,'metric','v9.4','v10','delta'; for my $k(qw(messages recipients sent spam virus dsn auth rejected)){ printf "%-14s %10d %10d %+10d\n",$k,$v9{$k},$v10{$k},$v10{$k}-$v9{$k}; }
print "\nLegacy identical auth.dat duplicate lines: $auth_dups\n";
print "NOTE: 'spam' is not expected to match exactly: v10 intentionally separates engine detection from final rejection.\n";
print "Legacy message counts use imported envelope events (senders.dat semantics); replay/live dates fall back to first_seen message rows.\n";
