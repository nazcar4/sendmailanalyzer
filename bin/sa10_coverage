#!/usr/bin/env perl
use strict; use warnings; use FindBin qw($Bin); use lib '/usr/lib/sendmailanalyzer/lib'; use lib "$Bin/../lib";
use Getopt::Long; use JSON::PP qw(encode_json); use SendmailAnalyzer::Config; use SendmailAnalyzer::Coverage; use SendmailAnalyzer::LogReader;
my ($json,$year,$samples,$config)=(0,undef,30,'/etc/sendmailanalyzer.conf'); GetOptions('json!'=>\$json,'year=i'=>\$year,'samples=i'=>\$samples,'config=s'=>\$config) or die "usage: sa10_coverage [--config file] [--json] [--year YYYY] [mail.log [rspamd.log ...]]\n";
my $cfg=SendmailAnalyzer::Config->load($config); my $c=SendmailAnalyzer::Coverage->new;
my %popt=(header_routes=>$cfg->{HEADER_ROUTES},header_ignore=>$cfg->{HEADER_IGNORE});
if (@ARGV) {
    for my $path (@ARGV) { my ($fh)=SendmailAnalyzer::LogReader->open_reader($path); while(my $l=<$fh>) { $c->add_line($l,defined($year)?(year=>$year):(),source_file=>$path,%popt); } close $fh; }
} else { while(my $l=<STDIN>) { $c->add_line($l,defined($year)?(year=>$year):(),%popt); } }
my $r=$c->report;
if ($json) { print encode_json($r),"\n"; exit 0; }
printf "Lines: %d\nParsed: %d\nIgnored-known: %d\nUnknown: %d\nEffective coverage: %s%%\n",@$r{qw(total parsed ignored unknown coverage_pct)};
print "\nBy source:\n"; printf "  %-18s %d\n",$_,$r->{by_source}{$_} for sort keys %{$r->{by_source}};
print "\nKnown ignored:\n"; printf "  %-28s %d\n",$_,$r->{ignored_reason}{$_} for sort keys %{$r->{ignored_reason}};
print "\nTop unknown patterns:\n"; my $n=0; for my $s (sort {$r->{unknown_samples}{$b}<=>$r->{unknown_samples}{$a}} keys %{$r->{unknown_samples}}) { printf "  %6d  %s\n",$r->{unknown_samples}{$s},$s; last if ++$n >= $samples; }
