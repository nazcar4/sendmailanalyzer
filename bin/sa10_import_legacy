#!/usr/bin/env perl
use strict; use warnings; use FindBin qw($Bin); use lib '/usr/lib/sendmailanalyzer/lib'; use lib "$Bin/../lib"; use Getopt::Long; use SendmailAnalyzer::Config; use SendmailAnalyzer::Storage::SQLite; use SendmailAnalyzer::LegacyImporter;
my $config='/etc/sendmailanalyzer.conf'; my ($root,$db,$until); GetOptions('config=s'=>\$config,'from=s'=>\$root,'db=s'=>\$db,'until=s'=>\$until) or die "usage: sa10_import_legacy [--config file] [--from legacy-dir] [--db file] [--until YYYY-MM-DD]\n"; die "--until must be YYYY-MM-DD\n" if defined($until) && $until !~ /^\d{4}-\d{2}-\d{2}$/;
my $cfg=SendmailAnalyzer::Config->load($config); $root||=$cfg->{LEGACY_DATA_DIR}; $db||=$cfg->{DB_FILE}; if ($> == 0 && $db =~ m{^/var/lib/sendmailanalyzer(?:/|$)}) { die "Refusing to create/write the service database as root. Run through: runuser -u sendmailanalyzer -- /usr/bin/sa10_import_legacy ...\n"; } my $st=SendmailAnalyzer::Storage::SQLite->new(file=>$db); my $progress=sub { my ($m)=@_; print $m,"\n"; }; my $r=SendmailAnalyzer::LegacyImporter->new(storage=>$st)->import_tree($root, defined($until)?(until=>$until):(),progress=>$progress); print "Imported files=$r->{files} archived_files=$r->{archived_files} archives=$r->{archives} archive_extractions=$r->{archive_extractions} lines=$r->{lines} events=$r->{events} messages=$r->{messages} normalized=$r->{normalized} generic=$r->{generic} synthetic_aggregated=$r->{synthetic_skipped}\n";
