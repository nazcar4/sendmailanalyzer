use strict; use warnings; use utf8;
use FindBin qw($Bin); use lib "$Bin/../lib";
use JSON::PP qw(encode_json); use Encode qw(encode_utf8); use URI::Escape qw(uri_unescape uri_escape_utf8);
use POSIX qw(strftime); use Time::Local qw(timelocal); use SendmailAnalyzer::Config; use SendmailAnalyzer::Storage::SQLite;

my $config=$ENV{SENDMAILANALYZER_CONFIG} || '/etc/sendmailanalyzer.conf';
my $cfg=SendmailAnalyzer::Config->load($config);
my $storage;
sub st { $storage ||= SendmailAnalyzer::Storage::SQLite->new(file=>$cfg->{DB_FILE},readonly=>1) }
sub h { my $s=defined $_[0]?"$_[0]":''; $s =~ s/&/&amp;/g; $s =~ s/</&lt;/g; $s =~ s/>/&gt;/g; $s =~ s/"/&quot;/g; $s =~ s/'/&#39;/g; return $s; }
sub params { my ($env)=@_; my %p; for(split /&/,$env->{QUERY_STRING}||''){ my($k,$v)=split /=/,$_,2; $k||=''; $v||=''; $k =~ tr/+/ /; $v =~ tr/+/ /; $k=uri_unescape($k); $v=uri_unescape($v); $p{$k}=$v if length $k; } return \%p; }
sub headers { my ($type)=@_; return ['Content-Type'=>$type,'X-Content-Type-Options'=>'nosniff','X-Frame-Options'=>'SAMEORIGIN','Referrer-Policy'=>'no-referrer','Permissions-Policy'=>'camera=(), microphone=(), geolocation=()','Content-Security-Policy'=>"default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; frame-ancestors 'self'; base-uri 'none'; form-action 'self'",'Cache-Control'=>'no-store']; }
sub json_response { return [$_[0]||200,headers('application/json; charset=utf-8'),[encode_json($_[1])]]; }
sub html_response { my ($status,$html)=@_; return [$status||200,headers('text/html; charset=utf-8'),[encode_utf8($html)]]; }
sub request_prefix { my ($env)=@_; my $p=$env->{HTTP_X_FORWARDED_PREFIX}||''; return '' if $p eq ''; return '' if $p !~ m{^/[A-Za-z0-9._/-]+$}; $p =~ s{/$}{}; return $p; }
sub u { my ($prefix,$path)=@_; $prefix||=''; $path='/' if !defined($path)||$path eq ''; $path='/'.$path if $path !~ m{^/}; return $prefix.$path; }
sub fmt { my $n=defined($_[0])?0+$_[0]:0; my $s="$n"; 1 while $s =~ s/^(-?\d+)(\d{3})/$1,$2/; return $s; }
sub pct { my($a,$b)=@_; return '0%' if !$b; return sprintf('%.1f%%',100*$a/$b); }
sub badge { my($text,$kind)=@_; $kind||='neutral'; return '<span class="badge '.h($kind).'">'.h($text).'</span>'; }
sub section_head { my($title,$sub)=@_; return '<div class="sectionhead"><div><h2>'.h($title).'</h2>'.($sub?'<p>'.h($sub).'</p>':'').'</div></div>'; }
sub kpi { my($label,$value,$sub,$kind)=@_; $kind||='blue'; return '<section class="kpi kpi-'.h($kind).'"><div class="kpi-label">'.h($label).'</div><div class="kpi-value">'.h(fmt($value)).'</div><div class="kpi-sub">'.h($sub||'').'</div></section>'; }
sub side_link {
    my($prefix,$path,$label,$active,$kind)=@_; $kind||='blue';
    my $on=($active eq $path || ($path ne '/' && index($active,$path.'/')==0))?' active':'';
    return '<a class="side-link'.$on.'" href="'.h(u($prefix,$path)).'"><span class="side-arrow">›</span><span>'.h($label).'</span></a>';
}
sub sidebar_nav {
    my($prefix,$active)=@_;
    return '<div class="classic-nav-group"><div class="classic-nav-title">GLOBAL STATISTICS</div>'.
      side_link($prefix,'/','Messaging',$active,'blue').
      side_link($prefix,'/spam','Spam',$active,'amber').
      side_link($prefix,'/viruses','Virus',$active,'red').
      side_link($prefix,'/dsn','Notifications / DSN',$active,'teal').
      side_link($prefix,'/rejects','Rejections and errors',$active,'red').
      side_link($prefix,'/status','Status / Flow',$active,'blue').
      side_link($prefix,'/auth','Authentication',$active,'purple').
      side_link($prefix,'/tls','TLS',$active,'teal').
      side_link($prefix,'/rspamd','Rspamd',$active,'purple').'</div>'.
      '<div class="classic-nav-group"><div class="classic-nav-title">TOP STATISTICS</div>'.
      side_link($prefix,'/senders','Senders',$active,'blue').
      side_link($prefix,'/recipients','Recipients',$active,'purple').
      side_link($prefix,'/spam','Spam',$active,'amber').
      side_link($prefix,'/viruses','Virus',$active,'red').
      side_link($prefix,'/rejects','Rejections',$active,'red').'</div>'.
      '<div class="classic-nav-group"><div class="classic-nav-title">DETAIL</div>'.
      side_link($prefix,'/messages','Messages',$active,'blue').
      side_link($prefix,'/direction/inbound','Inbound',$active,'blue').
      side_link($prefix,'/direction/outbound','Outbound',$active,'purple').
      side_link($prefix,'/direction/internal','Internal',$active,'teal').
      side_link($prefix,'/direction/unknown','Unclassified',$active,'navy').
      side_link($prefix,'/security','Security',$active,'navy').'</div>'.
      '<div class="classic-nav-group"><div class="classic-nav-title">DATA</div><a class="side-link" href="'.h(u($prefix,'/api/stats')).'" target="_blank" rel="noopener noreferrer" title="Open JSON API in a new tab"><span class="side-arrow">›</span><span>API JSON ↗</span></a><a class="side-link" href="'.h(u($prefix,'/metrics')).'" target="_blank" rel="noopener noreferrer" title="Open Metrics in a new tab"><span class="side-arrow">›</span><span>Metrics ↗</span></a></div>';
}
sub valid_date { return defined($_[0]) && $_[0] =~ /^\d{4}-\d{2}-\d{2}$/ ? $_[0] : strftime('%Y-%m-%d',localtime); }
sub date_epoch { my($d)=@_; my($y,$m,$day)=split /-/,$d; return eval { timelocal(0,0,12,$day,$m-1,$y) }; }
sub date_shift { my($d,$delta)=@_; my $e=date_epoch($d); return $d if !defined $e; return strftime('%Y-%m-%d',localtime($e+86400*$delta)); }
sub month_shift { my($d,$delta)=@_; my($y,$m)=split /-/,$d; $m += $delta; while($m<1){$m+=12;$y--} while($m>12){$m-=12;$y++} return sprintf('%04d-%02d-01',$y,$m); }
sub days_in_month { my($d)=@_; my($y,$m)=split /-/,$d; my $ny=$y; my $nm=$m+1; if($nm==13){$nm=1;$ny++} my $e=eval{timelocal(0,0,12,1,$nm-1,$ny)}; return 31 if !defined $e; return 0+(strftime('%d',localtime($e-86400))); }
sub month_name { my($m)=@_; my @n=qw(January February March April May June July August September October November December); return $n[$m-1]||''; }
sub month_index {
    my($prefix,$date,$scope)=@_; $date=valid_date($date); $scope||='day'; my($y,$m)=split /-/,$date; my @abbr=qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec);
    my $prevy=sprintf('%04d-%02d-01',$y-1,$m); my $nexty=sprintf('%04d-%02d-01',$y+1,$m); my $available=st()->available_months_for_year($y);
    my $months='';
    for my $mm(1..12){
        my $ym=sprintf('%04d-%02d',$y,$mm); my $ds=$ym.'-01'; my $cl=($scope eq 'month' && $mm==$m)?' active':'';
        if($available->{$ym}){ $months.='<a class="month-link'.$cl.'" href="'.h(u($prefix,'/?date='.$ds.'&scope=month&hour=')).'">'.$abbr[$mm-1].'</a>'; }
        else { $months.='<span class="month-link disabled'.$cl.'" aria-disabled="true">'.$abbr[$mm-1].'</span>'; }
    }
    return '<div class="month-index"><div class="year-line"><a href="'.h(u($prefix,'/?date='.$prevy.'&scope=month&hour=')).'">‹</a><strong>Year: '.$y.'</strong><a href="'.h(u($prefix,'/?date='.$nexty.'&scope=month&hour=')).'">›</a></div><div class="month-caption">Months</div><div class="month-grid">'.$months.'</div></div>';
}
sub calendar_widget {
    my($prefix,$date)=@_; $date=valid_date($date); my($y,$m,$sel)=split /-/,$date; my $dim=days_in_month($date); my $first=date_epoch(sprintf('%04d-%02d-01',$y,$m)); my $w=(localtime($first))[6]; $w=($w+6)%7; my $available=st()->available_days_for_month(sprintf('%04d-%02d',$y,$m));
    my $html='<div class="days-calendar"><div class="days-title">Days</div><div class="days-week"><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span></div><div class="days-grid">';
    $html.='<span class="day-empty"></span>' for 1..$w;
    for my $d(1..$dim){
        my $ds=sprintf('%04d-%02d-%02d',$y,$m,$d); my $cl=$d==0+$sel?' selected':'';
        if($available->{$ds}){ $html.='<a class="day-cell'.$cl.'" href="'.h(u($prefix,'/?date='.$ds.'&hour=')).'">'.sprintf('%02d',$d).'</a>'; }
        else { $html.='<span class="day-cell disabled'.$cl.'" aria-disabled="true">'.sprintf('%02d',$d).'</span>'; }
    }
    return $html.'</div></div>';
}
sub time_console {
    my($prefix,$date,$hour,$period_scope)=@_; $date=valid_date($date); $period_scope=($period_scope||'') eq 'month'?'month':'day'; $hour='' if $period_scope eq 'month' || !defined($hour)||$hour !~ /^(?:[01]\d|2[0-3])$/; my($y,$m,$sel)=split /-/,$date;
    my($prev,$next,$date_title,$report_kind);
    if($period_scope eq 'month'){
        $prev=month_shift($date,-1); $next=month_shift($date,1); $date_title=month_name($m).' '.$y; $report_kind='Monthly Report';
    } else {
        $prev=date_shift($date,-1); $next=date_shift($date,1); $date_title=sprintf('%02d %s %04d',0+$sel,month_name($m),$y); $report_kind=$hour eq ''?'Daily Report':'Hourly Report · '.$hour.':00';
    }
    my $hours=''; for my $hh(0..23){ my $hs=sprintf('%02d',$hh); my $cl=$hour eq $hs?' active':''; $hours.='<a class="hour-cell'.$cl.'" href="'.h(u($prefix,'/?date='.$date.'&hour='.$hs)).'">'.$hs.'</a>'; }
    my $dayclass=$period_scope eq 'day' && $hour eq ''?' active':'';
    my $navsuffix=$period_scope eq 'month'?'&scope=month&hour=':'&hour=';
    my $prev_has=$period_scope eq 'month' ? st()->month_has_data(substr($prev,0,7)) : st()->day_has_data($prev);
    my $next_has=$period_scope eq 'month' ? st()->month_has_data(substr($next,0,7)) : st()->day_has_data($next);
    my $prev_nav=$prev_has?'<a href="'.h(u($prefix,'/?date='.$prev.$navsuffix)).'">&lt;&lt; Previous</a>':'<span class="nav-disabled" aria-disabled="true">&lt;&lt; Previous</span>';
    my $next_nav=$next_has?'<a href="'.h(u($prefix,'/?date='.$next.$navsuffix)).'">Next &gt;&gt;</a>':'<span class="nav-disabled" aria-disabled="true">Next &gt;&gt;</span>';
    my $hours_box=$period_scope eq 'month'?'<div class="month-scope-note">Select a calendar day to return to daily detail.</div>':'<div class="hours-box"><div class="hours-title">Hours</div><div class="hours-row"><a class="hour-cell day-reset'.$dayclass.'" href="'.h(u($prefix,'/?date='.$date.'&hour=')).'">Day</a>'.$hours.'</div></div>';
    return '<div class="period-console">'.month_index($prefix,$date,$period_scope).'<div class="period-center"><div class="period-prevnext">'.$prev_nav.'<strong>'.h($date_title).'</strong>'.$next_nav.'</div><div class="report-kind">'.h($report_kind).'</div>'.$hours_box.'</div><div class="period-calendar">'.calendar_widget($prefix,$date).'</div></div>';
}
sub layout {
    my($title,$body,$prefix,$active,$period)=@_; $active||='/'; my $now=strftime('%Y-%m-%d %H:%M',localtime); my $nav=sidebar_nav($prefix,$active); $period||={date=>strftime('%Y-%m-%d',localtime),hour=>'',scope=>'day'}; my $console=time_console($prefix,$period->{date},$period->{hour},$period->{scope});
    return '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'.h($title).' · SendmailAnalyzer 10</title><link rel="stylesheet" href="'.h(u($prefix,'/assets/app.css')).'"></head><body><header class="topbar"><a class="brand" href="'.h(u($prefix,'/')).'"><span class="brand-copy"><strong>SendmailAnalyzer Report</strong><small>v10.0.16</small></span></a><details class="mobile-menu"><summary>Menu</summary><div class="mobile-menu-body">'.$nav.'</div></details><div class="readonly"><span class="live-dot"></span>real-time report</div></header><div class="app-shell"><aside class="sidebar"><div class="side-scroll">'.$nav.'</div><div class="side-foot"><span class="live-dot"></span>Collector active<br><small>'.h($now).'</small><div class="side-credit">Powered by SendmailAnalyzer v10.0.16 (GPLv3)<br>v10 by Nazcar</div></div></aside><main>'.$console.$body.'<footer class="classic-footer"><div><strong>Powered by SendmailAnalyzer v10.0.16 (GPLv3)</strong><br><span class="project-credit">v10 © 2026 Nazcar · Original SendmailAnalyzer © 2002–2020 Gilles Darold</span></div><span>'.h($now).'</span></footer></main></div></body></html>';
}
sub mini_bar { my($value,$max,$kind)=@_; $max||=1; my $w=$max?int(100*$value/$max):0; $w=100 if $w>100; $w=0 if $w<0; return '<svg class="minibar" viewBox="0 0 100 8" preserveAspectRatio="none"><rect class="track" x="0" y="1" width="100" height="6" rx="3"></rect><rect class="fill fill-'.h($kind||'blue').'" x="0" y="1" width="'.$w.'" height="6" rx="3"></rect></svg>'; }
sub top_table { my($rows,$field,$countfield,$extra,$kind)=@_; return '<div class="empty">No data.</div>' if !@$rows; my $max=$rows->[0]{$countfield}||1; my $o='<div class="ranking">'; my $i=1; for my $r(@$rows){ my $meta=$extra?$extra->($r):''; $o.='<div class="rankrow"><span class="rankno">'.$i.'</span><div class="rankbody"><div class="rankline"><span class="rankname" title="'.h($r->{$field}).'">'.h($r->{$field}).'</span><strong>'.h(fmt($r->{$countfield})).'</strong></div>'.mini_bar($r->{$countfield},$max,$kind).($meta?'<div class="rankmeta">'.h($meta).'</div>':'').'</div></div>'; $i++; } return $o.'</div>'; }
sub flow_line_chart {
    my($rows,$xkey)=@_; $xkey||='hour'; return '<div class="empty">No data.</div>' if !@$rows; my $max=1; for my $r(@$rows){ for my $k(qw(inbound outbound internal unknown)){ $max=$r->{$k} if ($r->{$k}||0)>$max; } }
    my($W,$H,$left,$right,$top,$base)=(620,245,45,600,24,194); my $plot=$base-$top; my $n=@$rows; my $step=$n>1?($right-$left)/($n-1):0; my $svg='<svg class="classic-line-chart" viewBox="0 0 '.$W.' '.$H.'" role="img" aria-label="Message flow">';
    for my $g(0..4){ my $y=$top+$plot*$g/4; my $v=int($max*(4-$g)/4); $svg.='<line class="gridline" x1="'.$left.'" y1="'.$y.'" x2="'.$right.'" y2="'.$y.'"></line><text class="axis-y" x="39" y="'.($y+3).'">'.h(fmt($v)).'</text>'; }
    for my $i(0..$#$rows){ my $show=$xkey eq 'hour' ? (!($i%2) || $i==$#$rows) : ($i==0 || $i==$#$rows || !($i%3)); next if !$show; my $x=$left+$i*$step; my $lab=$rows->[$i]{$xkey}//''; $lab=sprintf('%02d',0+$lab) if $xkey eq 'hour'; $lab=substr($lab,8,2) if $xkey eq 'day'; $svg.='<text class="axis-x" x="'.sprintf('%.2f',$x).'" y="213">'.h($lab).'</text>'; }
    for my $spec (['inbound','line-in'],['outbound','line-out'],['internal','line-local'],['unknown','line-unknown']){ my($field,$class)=@$spec; my @p; my $i=0; for my $r(@$rows){ my $x=$left+$i*$step; my $v=$r->{$field}||0; my $y=$base-($max?$plot*$v/$max:0); push @p,sprintf('%.2f,%.2f',$x,$y); $i++; } $svg.='<polyline class="'.$class.'" points="'.join(' ',@p).'"></polyline>'; }
    return $svg.'</svg><div class="chartlegend"><span><i class="legend-dot ld-in"></i>Inbound</span><span><i class="legend-dot ld-out"></i>Outbound</span><span><i class="legend-dot ld-local"></i>Internal</span><span><i class="legend-dot ld-unknown"></i>Unclassified</span></div>';
}
sub size_flow_line_chart {
    my($rows,$xkey)=@_; $xkey||='hour'; return '<div class="empty">No data.</div>' if !@$rows; my $max=1; for my $r(@$rows){ for my $k(qw(inbound_bytes outbound_bytes internal_bytes unknown_bytes)){ $max=$r->{$k} if ($r->{$k}||0)>$max; } }
    my($W,$H,$left,$right,$top,$base)=(620,245,48,600,24,194); my $plot=$base-$top; my $n=@$rows; my $step=$n>1?($right-$left)/($n-1):0; my $svg='<svg class="classic-line-chart" viewBox="0 0 '.$W.' '.$H.'" role="img" aria-label="Message flow size">';
    for my $g(0..4){ my $y=$top+$plot*$g/4; my $v=$max*(4-$g)/4/1048576; $svg.='<line class="gridline" x1="'.$left.'" y1="'.$y.'" x2="'.$right.'" y2="'.$y.'"></line><text class="axis-y" x="42" y="'.($y+3).'">'.sprintf('%.2f',$v).'</text>'; }
    for my $i(0..$#$rows){ my $show=$xkey eq 'hour' ? (!($i%2) || $i==$#$rows) : ($i==0 || $i==$#$rows || !($i%3)); next if !$show; my $x=$left+$i*$step; my $lab=$rows->[$i]{$xkey}//''; $lab=sprintf('%02d',0+$lab) if $xkey eq 'hour'; $lab=substr($lab,8,2) if $xkey eq 'day'; $svg.='<text class="axis-x" x="'.sprintf('%.2f',$x).'" y="213">'.h($lab).'</text>'; }
    for my $spec (['inbound_bytes','line-in'],['outbound_bytes','line-out'],['internal_bytes','line-local'],['unknown_bytes','line-unknown']){ my($field,$class)=@$spec; my @p; my $i=0; for my $r(@$rows){ my $x=$left+$i*$step; my $v=$r->{$field}||0; my $y=$base-($max?$plot*$v/$max:0); push @p,sprintf('%.2f,%.2f',$x,$y); $i++; } $svg.='<polyline class="'.$class.'" points="'.join(' ',@p).'"></polyline>'; }
    my $unit=$xkey eq 'day'?'MB per day':'MB per hour';
    return $svg.'</svg><div class="chartlegend"><span><i class="legend-dot ld-in"></i>Inbound</span><span><i class="legend-dot ld-out"></i>Outbound</span><span><i class="legend-dot ld-local"></i>Internal</span><span><i class="legend-dot ld-unknown"></i>Unclassified</span><span>'.h($unit).'</span></div>';
}
sub direction_distribution_table {
    my($flows)=@_; my %name=(inbound=>'External → Internal',outbound=>'Internal → External',internal=>'Internal → Internal',relay=>'Relay',unknown=>'Unclassified'); my $total=0; $total+=($_->{messages}||0) for @$flows; my @tr;
    for my $key(qw(inbound outbound internal relay unknown)){ my($r)=grep{($_->{direction}||'') eq $key}@$flows; my $n=$r?($r->{messages}||0):0; my $b=$r?($r->{bytes}||0):0; push @tr,'<tr><td>'.h($name{$key}).'</td><td class="num">'.fmt($n).'</td><td class="num">'.sprintf('%.2f',$b/1048576).'</td><td class="num">'.pct($n,$total).'</td></tr>'; }
    return simple_table(['Direction','Messages','Size (MB)','Percentage'],\@tr,'classic-table');
}
sub direction_donut {
    my($flows)=@_; my %v=map{($_->{direction}||'unknown')=>0+($_->{messages}||0)}@$flows; my $total=0; $total+=$_ for values %v; return '<div class="empty">No data.</div>' if !$total;
    my @seg=(['inbound','pie-in','Ext → Int'],['outbound','pie-out','Int → Ext'],['internal','pie-local','Int → Int'],['relay','pie-relay','Relay'],['unknown','pie-unknown','Unclassified']); my $circ=314.159; my $off=0; my $svg='<div class="donut-wrap"><svg class="direction-donut" viewBox="0 0 220 190" role="img" aria-label="Delivery direction"><circle class="pie-base" cx="92" cy="88" r="50"></circle>';
    for my $s(@seg){ my($k,$cl,$lab)=@$s; my $n=$v{$k}||0; next if !$n; my $len=$circ*$n/$total; $svg.='<circle class="'.$cl.'" cx="92" cy="88" r="50" stroke-dasharray="'.sprintf('%.3f %.3f',$len,$circ-$len).'" stroke-dashoffset="'.sprintf('%.3f',-$off).'" transform="rotate(-90 92 88)"><title>'.h($lab.' '.$n.' · '.pct($n,$total)).'</title></circle>'; $off+=$len; }
    $svg.='<circle class="pie-hole" cx="92" cy="88" r="24"></circle><text class="pie-total" x="92" y="84">'.fmt($total).'</text><text class="pie-caption" x="92" y="99">messages</text></svg><div class="pie-legend">';
    for my $s(@seg){ my($k,$cl,$lab)=@$s; my $n=$v{$k}||0; $svg.='<span><i class="legend-dot '.($cl=~s/^pie-/ld-pie-/r).'"></i>'.h($lab).' <b>'.pct($n,$total).'</b></span>'; }
    return $svg.'</div></div>';
}
sub unique_parties_table {
    my($r)=@_; my @tr=('<tr><td class="num">'.fmt($r->{senders}).'</td><td class="num">'.fmt($r->{recipients}).'</td></tr>'); return simple_table(['Senders','Recipients'],\@tr,'classic-table');
}
sub segmented_meter { my($parts)=@_; my $total=0; $total += $_->{value}||0 for @$parts; $total||=1; my $x=0; my $svg='<svg class="meter" viewBox="0 0 100 14" preserveAspectRatio="none">'; for my $p(@$parts){ my $w=100*($p->{value}||0)/$total; $svg.='<rect class="seg-'.h($p->{kind}).'" x="'.sprintf('%.3f',$x).'" y="1" width="'.sprintf('%.3f',$w).'" height="12"></rect>'; $x+=$w; } $svg.='</svg><div class="meter-legend">'; for my $p(@$parts){ $svg.='<span><i class="legend-dot ld-'.h($p->{kind}).'"></i>'.h($p->{label}).'<b>'.h(fmt($p->{value})).'</b><em>'.h(pct($p->{value},$total)).'</em></span>'; } return $svg.'</div>'; }
sub period_chart {
    my($rows,$key,$title)=@_; return '<div class="empty">No data.</div>' if !@$rows; my $max=1; for my $r(@$rows){ for my $k(qw(messages rejected spam_detected)){ $max=$r->{$k} if ($r->{$k}||0)>$max; } } my $W=980; my $H=280; my $base=225; my $plot=195; my $n=@$rows; my $step=900/($n||1); my $bw=$step>22?5:($step/4); $bw=2 if $bw<2; my $svg='<svg class="bigchart" viewBox="0 0 '.$W.' '.$H.'" role="img" aria-label="'.h($title).'">'; for my $g(0..4){ my $y=30+$plot*$g/4; my $v=int($max*(4-$g)/4); $svg.='<line class="gridline" x1="52" y1="'.$y.'" x2="960" y2="'.$y.'"></line><text class="axis-y" x="46" y="'.($y+4).'">'.h(fmt($v)).'</text>'; } my $i=0; for my $r(@$rows){ my $cx=62+$i*$step; for my $s(['messages','blue',-$bw-1],['rejected','red',0],['spam_detected','amber',$bw+1]){ my($f,$kind,$off)=@$s; my $v=$r->{$f}||0; my $bh=$max?$plot*$v/$max:0; $svg.='<rect class="bar bar-'.h($kind).'" x="'.sprintf('%.2f',$cx+$off).'" y="'.sprintf('%.2f',$base-$bh).'" width="'.sprintf('%.2f',$bw).'" height="'.sprintf('%.2f',$bh).'"><title>'.h(($r->{$key}//'').' · '.$f.': '.$v).'</title></rect>'; } my $show=($n<=14 || $i==0 || $i==$n-1 || $i%3==0); if($show){ my $lab=$r->{$key}//''; $lab=substr($lab,5) if $key eq 'day'; $lab.='h' if $key eq 'hour'; $svg.='<text class="axis-x" x="'.sprintf('%.2f',$cx).'" y="247">'.h($lab).'</text>'; } $i++; } return $svg.'</svg><div class="chartlegend"><span><i class="legend-dot ld-blue"></i>Messages</span><span><i class="legend-dot ld-red"></i>Rejected</span><span><i class="legend-dot ld-amber"></i>Spam</span></div>'; }
sub size_chart {
    my($rows)=@_; return '<div class="empty">No data.</div>' if !@$rows; my $max=1; for(@$rows){$max=$_->{size_bytes} if ($_->{size_bytes}||0)>$max} my $W=760; my $H=245; my $base=198; my $plot=165; my $step=680/24; my $bw=13; my $svg='<svg class="classic-chart" viewBox="0 0 '.$W.' '.$H.'" role="img" aria-label="Hourly message volume">'; for my $g(0..4){my $y=28+$plot*$g/4; my $v=int($max*(4-$g)/4/1048576); $svg.='<line class="gridline" x1="50" y1="'.$y.'" x2="735" y2="'.$y.'"></line><text class="axis-y" x="45" y="'.($y+3).'">'.$v.' MB</text>';} my $i=0; for my $r(@$rows){my $v=$r->{size_bytes}||0; my $bh=$max?$plot*$v/$max:0; my $x=57+$i*$step; $svg.='<rect class="bar-size" x="'.sprintf('%.2f',$x).'" y="'.sprintf('%.2f',$base-$bh).'" width="'.$bw.'" height="'.sprintf('%.2f',$bh).'"><title>'.h($r->{hour}.':00 · '.sprintf('%.2f MB',$v/1048576)).'</title></rect><text class="axis-x" x="'.sprintf('%.2f',$x+$bw/2).'" y="217">'.h($r->{hour}).'</text>'; $i++;} return $svg.'</svg><div class="chartlegend"><span><i class="legend-dot ld-blue"></i>Processed volume (MB)</span></div>';
}
sub classic_flow_table {
    my($rows)=@_; my %r=map{($_->{direction}||'unknown')=>$_}@$rows; my @dirs=(['inbound','Inbound'],['outbound','Outbound'],['internal','Internal'],['relay','Relay'],['unknown','Unclassified']); my($tm,$tb,$td)=(0,0,0); my $o='<table class="classic-table"><thead><tr><th>Flow</th><th>Messages</th><th>Size MB</th><th>Average KB</th><th>Deliveries</th></tr></thead><tbody>'; for my $d(@dirs){my $x=$r{$d->[0]}||{}; my $m=0+($x->{messages}||0); my $b=0+($x->{bytes}||0); my $del=0+($x->{delivered}||0); $tm+=$m;$tb+=$b;$td+=$del; $o.='<tr><td>'.h($d->[1]).'</td><td class="num">'.fmt($m).'</td><td class="num">'.sprintf('%.2f',$b/1048576).'</td><td class="num">'.sprintf('%.1f',$m?$b/$m/1024:0).'</td><td class="num">'.fmt($del).'</td></tr>';} $o.='<tr class="classic-total"><td>Total</td><td class="num">'.fmt($tm).'</td><td class="num">'.sprintf('%.2f',$tb/1048576).'</td><td class="num">'.sprintf('%.1f',$tm?$tb/$tm/1024:0).'</td><td class="num">'.fmt($td).'</td></tr></tbody></table>'; return $o;
}
sub spam_chart { my($rows)=@_; return '<div class="empty">No data.</div>' if !@$rows; my @mapped=map{{day=>$_->{day},messages=>$_->{detected}||0,rejected=>$_->{rejected}||0,spam_detected=>$_->{delivered}||0}}@$rows; my $x=period_chart(\@mapped,'day','Spam by day'); $x =~ s/>Spam</>Delivered</; return $x; }
sub msg_status { my($m)=@_; return ('Rejected','bad') if $m->{rejected}; return ('Deferred','warn') if $m->{deferred_count}; return ('Delivered','good') if $m->{delivered_count}; return ('Processed','neutral'); }
sub msg_table { my($rows,$prefix)=@_; my $x='<div class="tablewrap"><table class="msgtable"><thead><tr><th>Date</th><th>Queue-ID</th><th>Direction</th><th>Sender</th><th>Status</th><th>Spam</th><th>Rspamd</th></tr></thead><tbody>'; for my $m(@$rows){ my($status,$kind)=msg_status($m); my $dir=$m->{direction}||'unknown'; my $dir_label=$dir eq 'unknown'?'Unclassified':$dir; my $dk=$dir eq 'inbound'?'blue':$dir eq 'outbound'?'purple':$dir eq 'internal'?'teal':'neutral'; my $shown=$m->{display_queue_id}||$m->{queue_id}; $x.='<tr><td class="datecell">'.h($m->{last_seen}||$m->{first_seen}).'</td><td><a class="qid" href="'.h(u($prefix,'/message/'.uri_escape_utf8($m->{queue_id}))).'">'.h($shown).'</a></td><td>'.badge($dir_label,$dk).'</td><td class="sendercell">'.h($m->{sender}).'</td><td>'.badge($status,$kind).'</td><td>'.($m->{spam_detected}?badge('detected','warn'):'—').'</td><td>'.h($m->{rspamd_action}||'—').'</td></tr>'; } return $x.'</tbody></table></div>'; }
sub pagehead { my($ey,$title,$sub)=@_; return '<div class="pagehead"><div><div class="eyebrow">'.h($ey).'</div><h1>'.h($title).'</h1><p>'.h($sub).'</p></div></div>'; }
sub simple_table { my($heads,$rows)=@_; my $o='<div class="tablewrap"><table><thead><tr>'.join('',map{'<th>'.h($_).'</th>'}@$heads).'</tr></thead><tbody>'; $o.=join('',@$rows); return $o.'</tbody></table></div>'; }

my $CSS=<<'CSS';
:root{font-family:Verdana,Arial,Helvetica,sans-serif;color:#334155;background:#eef2f3;--classic:#397da3;--classic-dark:#2d6889;--classic-light:#dcebf2;--gold:#d6a23a;--line:#b8cbd5;--panel:#fff;--ink:#334155;--muted:#6f7e87;--blue:#397da3;--green:#41955b;--red:#bb4c48;--amber:#d59a28;--purple:#755a9d;--teal:#398d8b;--navy:#2f5c78}*{box-sizing:border-box}body{margin:0;background:#eef2f3;color:var(--ink)}a{color:#296b92}.topbar{height:55px;background:#f7f7f5;border-bottom:4px solid var(--classic);display:flex;align-items:center;padding:0 16px;position:sticky;top:0;z-index:40}.brand{text-decoration:none;display:flex;align-items:center;gap:8px;height:48px}.brand-version{font-size:10px;background:#397da3;color:#fff;padding:2px 6px;border-radius:2px;border:1px solid #2d6889;box-shadow:inset 0 1px #6ca0ba}.readonly{margin-left:auto;font-size:10px;color:#65757f;text-transform:uppercase;letter-spacing:.05em;display:flex;gap:7px;align-items:center}.live-dot{width:7px;height:7px;border-radius:50%;background:#4cae63;display:inline-block}.app-shell{display:grid;grid-template-columns:215px minmax(0,1fr);min-height:calc(100vh - 55px)}.sidebar{background:#4b83a1;border-right:1px solid #2c6686;position:sticky;top:55px;height:calc(100vh - 55px);display:flex;flex-direction:column;color:#fff}.side-scroll{padding:10px 8px;overflow:auto}.classic-nav-group{margin:0 0 12px}.classic-nav-title{background:#2f6f93;color:#fff;border:1px solid #275f7d;text-align:center;font-size:10px;font-weight:700;letter-spacing:.04em;padding:5px 4px;box-shadow:inset 0 1px #6ca0ba}.side-link{display:flex;align-items:center;gap:5px;color:#f5fbff;text-decoration:none;font-size:11px;padding:5px 7px;border-bottom:1px solid #6d9db6;background:#4b83a1}.side-link:hover{background:#3c7595}.side-link.active{background:#f2e5c9;color:#774f18;font-weight:700;border-left:4px solid #d19a32;padding-left:3px}.side-arrow{font-size:14px;line-height:1;color:#dbeaf1}.side-link.active .side-arrow{color:#a56a1d}.side-foot{margin-top:auto;border-top:1px solid #6d9db6;padding:10px 12px;font-size:9px;line-height:1.6;color:#e2eef4}.mobile-menu{display:none;margin-left:20px}.mobile-menu summary{cursor:pointer;color:#2f6f93;font-weight:700;font-size:12px}.mobile-menu-body{position:absolute;left:8px;right:8px;top:48px;background:#4b83a1;padding:10px;border:1px solid #2c6686;max-height:82vh;overflow:auto;box-shadow:0 8px 30px #0005}main{min-width:0;padding:12px 15px 8px;max-width:1650px;width:100%;margin:0 auto}footer{display:flex;justify-content:space-between;gap:20px;color:#7c8b94;font-size:9px;padding:14px 2px;border-top:1px solid #c8d7de;margin-top:12px}.classic-footer strong{color:#397da3}.project-credit{color:#8a6a31}.period-console{display:grid;grid-template-columns:205px minmax(0,1fr);gap:12px;margin-bottom:12px}.period-calendar,.period-selector{background:#fff;border:1px solid #b8cbd5;box-shadow:0 1px 3px #0001}.calendar{padding:5px}.calendar-head{height:25px;background:#e7d8b6;color:#71531e;display:grid;grid-template-columns:25px 1fr 25px;align-items:center;text-align:center;font-size:11px;border:1px solid #d4bd8d}.calendar-head a{text-decoration:none;color:#71531e;font-size:17px}.calendar-week,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;text-align:center}.calendar-week{font-size:8px;color:#65757f;padding-top:4px}.calendar-week span{padding:3px 0}.cal-day,.cal-empty{min-height:21px;display:grid;place-items:center;font-size:9px;text-decoration:none;color:#435561;background:#f4f7f8;border:1px solid #edf1f2}.cal-day:hover{background:#dcebf2}.cal-day.selected{background:#397da3;color:#fff;font-weight:700;border-color:#2d6889}.period-selector{padding:7px 10px}.period-prevnext{background:#397da3;color:#fff;display:grid;grid-template-columns:120px 1fr 120px;align-items:center;text-align:center;height:28px;font-size:10px}.period-prevnext a{color:#fff;text-decoration:none}.period-prevnext strong{font-size:12px}.period-label{text-align:center;color:#a27022;font-size:11px;font-weight:700;padding:6px 0 3px}.hours-label{padding-top:7px}.days-strip,.hours-strip{display:flex;justify-content:center;gap:2px;overflow-x:auto;padding:2px 1px 4px}.day-pill,.hour-pill{display:inline-grid;place-items:center;min-width:24px;height:21px;border:1px solid #b7c9d1;background:#edf3f5;color:#49616d;text-decoration:none;font-size:8px}.day-pill:hover,.hour-pill:hover{background:#dbeaf0}.day-pill.active,.hour-pill.active{background:#397da3;color:#fff;border-color:#2d6889;font-weight:700}.hour-pill{min-width:25px}.pagehead{margin:7px 0 9px}.eyebrow{display:none}.pagehead h1{margin:0;color:#a27022;font-size:18px;text-align:center;font-weight:700}.pagehead p{text-align:center;margin:3px 0;color:#788891;font-size:10px}.kpis{display:grid;grid-template-columns:repeat(6,minmax(105px,1fr));gap:6px}.kpi{background:#fff;border:1px solid #b8cbd5;padding:8px 9px;border-radius:0;box-shadow:none;border-top:4px solid #397da3}.kpi-green{border-top-color:#4f9963}.kpi-red{border-top-color:#b9524e}.kpi-amber{border-top-color:#d49b35}.kpi-purple{border-top-color:#78639c}.kpi-teal{border-top-color:#3e908e}.kpi-label{font-size:8px;color:#667781;text-transform:uppercase;font-weight:700}.kpi-value{font-size:20px;font-weight:700;color:#2f566b;margin-top:3px}.kpi-sub{font-size:8px;color:#87969d;margin-top:2px}.panel,.classic-panel{background:#fff;border:1px solid #b8cbd5;border-radius:0;padding:9px;box-shadow:none}.classic-panel{padding:0}.classic-title{background:#397da3;color:white;text-align:center;font-size:11px;font-weight:700;padding:4px;border-bottom:1px solid #2d6889}.classic-body{padding:7px}.mt{margin-top:9px}.two{display:grid;grid-template-columns:1fr 1fr;gap:9px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.dashboard-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:9px}.classic-report-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:9px}.classic-chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:9px}.sectionhead{margin-bottom:8px}.sectionhead h2{font-size:12px;color:#2f6f93;margin:0;border-bottom:1px solid #d6e1e6;padding-bottom:4px}.sectionhead p{font-size:9px;color:#7a8b94;margin:3px 0 0}.classic-table{width:100%;border-collapse:collapse;font-size:9px}.classic-table th{background:#e5d7b8;color:#72551f;text-align:center;padding:3px;border:1px solid #d2c39e;text-transform:none;letter-spacing:0}.classic-table td{padding:3px 5px;border:1px solid #d8e1e5;white-space:nowrap}.classic-table td.num{text-align:right;font-variant-numeric:tabular-nums}.classic-table tr:nth-child(even) td{background:#f7fafb}.bigchart{width:100%;height:250px;display:block}.classic-chart{width:100%;height:245px;display:block}.gridline{stroke:#e3d7c0;stroke-width:.8}.axis-y,.axis-x{font-size:8px;fill:#6d7a80}.axis-y{text-anchor:end}.axis-x{text-anchor:middle}.bar-blue{fill:#dda620}.bar-red{fill:#b8564f}.bar-amber{fill:#5a8ead}.bar-size{fill:#d89b21}.bar-in{fill:#d9aa3b}.bar-out{fill:#6d92ad}.chartlegend,.meter-legend{display:flex;gap:12px;flex-wrap:wrap;color:#697982;font-size:9px;justify-content:center;padding:4px}.legend-dot{display:inline-block;width:8px;height:8px;border:1px solid #8f8f8f;margin-right:4px}.ld-blue{background:#dda620}.ld-red{background:#b8564f}.ld-amber{background:#5a8ead}.ld-purple{background:#7d6b9f}.ld-teal{background:#4f9692}.ld-green{background:#579b67}.ld-gray{background:#97a7af}.ld-unknown{background:#97a7af}.meter{width:100%;height:28px}.seg-blue{fill:#d9aa3b}.seg-purple{fill:#6f8eaa}.seg-teal{fill:#4f9692}.seg-gray{fill:#97a7af}.seg-green{fill:#579b67}.seg-red{fill:#b8564f}.meter-legend{display:grid;grid-template-columns:1fr 1fr}.meter-legend span{display:flex;align-items:center}.meter-legend b{margin-left:auto}.meter-legend em{font-style:normal;color:#929fa5;margin-left:4px}.ranking{display:flex;flex-direction:column;gap:6px}.rankrow{display:grid;grid-template-columns:20px 1fr;gap:6px}.rankno{display:grid;place-items:center;width:18px;height:18px;background:#e3edf1;color:#547285;font-size:8px}.rankline{display:flex;gap:5px;font-size:10px}.rankname{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rankline strong{margin-left:auto}.rankmeta{font-size:8px;color:#8b989e}.minibar{width:100%;height:6px}.track{fill:#e8eff2}.fill-blue{fill:#d2a13b}.fill-purple{fill:#7e6b9d}.fill-red{fill:#b75b57}.fill-green{fill:#589867}.tablewrap{overflow:auto;border:1px solid #c3d2d9;border-radius:0}table{border-collapse:collapse;width:100%;font-size:10px;background:#fff}th,td{text-align:left;padding:6px 7px;border-bottom:1px solid #e0e8eb;white-space:nowrap}th{background:#397da3;color:white;font-size:8px;text-transform:uppercase;letter-spacing:.02em}tbody tr:hover td{background:#fff8e9}td a{color:#2d708f;text-decoration:none}.qid{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-weight:700}.sendercell{max-width:320px;overflow:hidden;text-overflow:ellipsis}.datecell{color:#657780}.badge{display:inline-flex;padding:2px 6px;border-radius:2px;font-size:8px;font-weight:700;background:#e7edf0;color:#60717b}.badge.good{background:#dcebdc;color:#377247}.badge.bad{background:#efd9d7;color:#923d3a}.badge.warn{background:#f4e7c7;color:#8a651e}.badge.blue{background:#dae8ef;color:#2e6d8c}.badge.purple{background:#e5dff0;color:#665286}.badge.teal{background:#d7ebe9;color:#357673}.searchbar,.period-form{display:flex;gap:6px;align-items:center}.searchbar input,.period-form input{padding:7px 8px;border:1px solid #b9cbd3;border-radius:0}.searchbar input{flex:1}.searchbar button,.period-form button{border:1px solid #2d6889;background:#397da3;color:white;padding:7px 12px;font-weight:700}.statlist{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.statbox{padding:8px;border:1px solid #d8e3e7;background:#f7fafb}.statbox .n{font-size:18px;font-weight:700;color:#2f6f93}.statbox .t{font-size:8px;color:#7b8b93}.note{padding:9px;border-left:3px solid #397da3;background:#eef5f8;color:#46616f;font-size:9px;line-height:1.5}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.category-card{display:block;text-decoration:none;color:inherit;background:#fff;border:1px solid #b8cbd5;padding:11px}.category-card:hover{background:#fff8e9}.category-card strong{display:block;color:#2f6f93;font-size:12px}.category-card span{display:block;color:#7c8a91;font-size:9px;margin-top:3px}.category-card b{display:block;font-size:20px;color:#a27022;margin-top:7px}.timeline{position:relative}.timeline:before{content:"";position:absolute;left:9px;top:6px;bottom:6px;width:2px;background:#d8e3e7}.event{position:relative;padding:0 0 12px 29px}.event-dot{position:absolute;left:4px;top:3px;width:11px;height:11px;border-radius:50%;background:#397da3;border:2px solid white;box-shadow:0 0 0 1px #91acba}.event-head{display:flex;gap:6px;align-items:center;font-size:9px;margin-bottom:3px}.event-time{color:#7f8d94}.event code{display:block;white-space:pre-wrap;word-break:break-word;font-size:9px;line-height:1.4;color:#52666f;background:#f6f9fa;border:1px solid #dce5e8;padding:6px}.detail-hero{background:#397da3;color:#fff;border:1px solid #2d6889}.detail-hero h1{margin:0;font-size:20px}.detail-hero p{color:#deedf4}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.kv{display:grid;grid-template-columns:125px 1fr;gap:6px 10px;font-size:10px}.kv dt{color:#70828b}.kv dd{margin:0;overflow-wrap:anywhere}.empty{text-align:center;color:#839198;padding:20px}.flow-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.flow-card{border:1px solid #c7d6dc;background:#f8fbfc;padding:6px;text-align:center}.flow-card b{display:block;color:#2f6f93;font-size:16px}.flow-card span{font-size:8px;color:#74858d}.classic-total{font-weight:700;background:#e8f0f3!important}.size-unit{font-size:8px;color:#75858d}@media(max-width:1100px){.period-console{grid-template-columns:185px minmax(0,1fr)}.kpis{grid-template-columns:repeat(3,1fr)}.classic-report-grid,.classic-chart-grid,.dashboard-grid{grid-template-columns:1fr}.category-grid{grid-template-columns:1fr 1fr}}@media(max-width:820px){.app-shell{display:block}.sidebar{display:none}.mobile-menu{display:block}.readonly{margin-left:auto}main{padding:8px}.period-console{grid-template-columns:1fr}.period-calendar{display:none}.period-prevnext{grid-template-columns:85px 1fr 85px}.two,.three,.info-grid{grid-template-columns:1fr}.kpis{grid-template-columns:repeat(2,1fr)}.category-grid{grid-template-columns:1fr}.bigchart,.classic-chart{height:215px}}@media(max-width:500px){.readonly{display:none}.kpi-value{font-size:18px}.meter-legend{grid-template-columns:1fr}}
/* 10.0.16: compact time navigation and classic-inspired report graphs */
.topbar{height:52px;padding:0 14px;border-bottom:2px solid var(--classic)}.brand{height:50px;gap:7px}.brand-copy{display:flex;align-items:baseline;gap:8px}.brand-copy strong{font-family:Verdana,Arial,sans-serif;font-size:22px;color:#c8650d;letter-spacing:-.03em}.brand-copy small{font-size:9px;color:#6b7d87}.app-shell{min-height:calc(100vh - 52px)}.sidebar{top:52px;height:calc(100vh - 52px)}
.period-console{display:grid;grid-template-columns:112px minmax(420px,1fr) 150px;gap:4px;margin:0 0 8px;border:1px solid #397da3;background:#f0f0f0}.month-index,.period-center,.period-calendar{background:#f0f0f0;border:0;box-shadow:none}.month-index{border-right:1px solid #397da3}.year-line{display:grid;grid-template-columns:18px 1fr 18px;align-items:center;height:23px;background:#397da3;color:#fff;font-size:9px;text-align:center}.year-line a{color:#fff;text-decoration:none;font-size:14px}.month-caption,.days-title,.hours-title{background:#397da3;color:#fff;text-align:center;font-size:9px;font-weight:700;padding:2px}.month-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding:2px}.month-link{font-size:8px;line-height:16px;text-align:center;color:#285e7d;text-decoration:none;border:1px solid transparent}.month-link:hover,.month-link.active{background:#dcebf2;border-color:#397da3}.month-link.active{font-weight:700;color:#c8650d}.period-center{min-width:0}.period-prevnext{height:23px;grid-template-columns:105px 1fr 105px;font-size:9px}.period-prevnext strong{font-size:10px}.report-kind{text-align:center;color:#c8650d;font-size:16px;line-height:24px}.month-scope-note{text-align:center;color:#657780;font-size:9px;line-height:24px}.hours-box{width:max-content;max-width:100%;margin:0 auto 3px;border:1px solid #397da3}.hours-title{padding:1px 5px}.hours-row{display:flex;align-items:center;white-space:nowrap;overflow-x:auto;background:#f0f0f0}.hour-cell{display:block;min-width:20px;height:17px;line-height:17px;text-align:center;font-size:8px;color:#2d6889;text-decoration:none;border-right:1px solid #d0d9de}.hour-cell:last-child{border-right:0}.hour-cell:hover,.hour-cell.active{background:#397da3;color:#fff}.day-reset{min-width:27px;font-weight:700}.period-calendar{border-left:1px solid #397da3}.days-calendar{padding:0}.days-title{height:22px;line-height:18px}.days-week,.days-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:0;text-align:center}.days-week span{font-size:7px;line-height:14px;color:#334d5b}.day-cell,.day-empty{display:block;min-height:15px;line-height:15px;font-size:8px;text-decoration:none;color:#2d6889;border:0;background:transparent}.day-cell:hover,.day-cell.selected{background:#397da3;color:#fff;font-weight:700}.month-link.disabled,.month-link.disabled:hover{background:transparent;border-color:transparent;color:#9ba8ae;font-weight:400;cursor:default}.day-cell.disabled,.day-cell.disabled:hover{background:transparent;color:#a3adb2;font-weight:400;cursor:default}.period-prevnext .nav-disabled{color:#9ba8ae;cursor:default}.report-scope{text-align:center;font-size:9px;color:#7a858a;margin:-1px 0 7px}.classic-visual-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start}.classic-graph-card{background:#f7f7f5;border:8px solid #fff;outline:1px solid #d7d7d2;border-radius:10px;box-shadow:3px 3px 8px #0002;padding:7px;max-width:650px;width:88%;justify-self:center}.classic-graph-card h3{text-align:center;margin:0 0 2px;font-size:12px;color:#555}.classic-line-chart{display:block;width:100%;height:245px}.line-in,.line-out,.line-local,.line-unknown{fill:none;stroke-width:2}.line-in{stroke:#16a8d4}.line-out{stroke:#a8cf18}.line-local{stroke:#e48b31}.line-unknown{stroke:#97a7af;stroke-dasharray:5 4}.ld-in{background:#16a8d4}.ld-out{background:#a8cf18}.ld-local{background:#e48b31}.direction-donut{display:block;width:260px;max-width:100%;height:190px;margin:0 auto}.pie-base,.pie-in,.pie-out,.pie-local,.pie-relay,.pie-unknown{fill:none;stroke-width:46}.pie-base{stroke:#edf0ed}.pie-in{stroke:#4bb5d8}.pie-out{stroke:#b8d833}.pie-local{stroke:#e06d62}.pie-relay{stroke:#7b8fa3}.pie-unknown{stroke:#97a7af}.pie-hole{fill:#f7f7f5}.pie-total{text-anchor:middle;font-size:18px;font-weight:700;fill:#3d5664}.pie-caption{text-anchor:middle;font-size:8px;fill:#79858c}.pie-legend{display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;font-size:8px;max-width:280px;margin:0 auto}.pie-legend span{display:flex;align-items:center;gap:3px}.pie-legend b{margin-left:auto}.ld-pie-in{background:#4bb5d8}.ld-pie-out{background:#b8d833}.ld-pie-local{background:#e06d62}.ld-pie-relay{background:#7b8fa3}.ld-pie-unknown{background:#97a7af}.compact-panel{align-self:center;max-width:500px;width:85%;justify-self:center}.side-credit{margin-top:8px;padding-top:6px;border-top:1px solid #72a0b8;font-size:7px;line-height:1.35;color:#e9f4f8}.classic-footer{background:#397da3;color:#fff;border:0;padding:5px 7px;margin-top:12px;font-size:8px}.classic-footer strong,.classic-footer .project-credit{color:#fff}
@media(max-width:1100px){.period-console{grid-template-columns:102px minmax(360px,1fr) 140px}.classic-visual-grid{grid-template-columns:1fr 1fr}.classic-graph-card{width:96%}}@media(max-width:820px){.period-console{grid-template-columns:1fr}.month-index,.period-calendar{display:none}.period-center{padding-bottom:3px}.classic-visual-grid{grid-template-columns:1fr}.classic-graph-card,.compact-panel{width:100%;max-width:none}.brand-copy strong{font-size:17px}.brand-copy small{display:none}.hours-row{justify-content:flex-start}.period-prevnext{grid-template-columns:85px 1fr 85px}}@media(max-width:500px){.brand-copy strong{font-size:14px}.readonly{display:none}}
CSS

my $app=sub{
    my $env=shift; my $path=$env->{PATH_INFO}||'/'; my $p=params($env); my $prefix=request_prefix($env);
    return [200,headers('text/css; charset=utf-8'),[$CSS]] if $path eq '/assets/app.css';
    return [204,headers('text/plain'),['']] if $path eq '/favicon.ico';
    if($path eq '/api/stats'){ return json_response(200,st()->stats()); }
    if($path eq '/api/messages'){ return json_response(200,st()->recent_messages(q=>substr($p->{q}||'',0,200),limit=>0+($p->{limit}||100))); }
    if($path =~ m{^/api/message/([A-Za-z0-9._-]+)$}){ my $m=st()->message_detail($1); return $m?json_response(200,$m):json_response(404,{error=>'not found'}); }
    if($path eq '/api/series'){ return json_response(200,st()->daily_series(30)); }
    if($path eq '/api/series/hourly'){ return json_response(200,st()->hourly_series(substr($p->{date}||'',0,10))); }
    if($path eq '/api/series/monthly'){ return json_response(200,st()->monthly_series(12)); }
    if($path eq '/api/top/senders'){ return json_response(200,st()->top_senders(20)); }
    if($path eq '/api/top/recipients'){ return json_response(200,st()->top_recipients(20)); }
    if($path eq '/api/security'){ return json_response(200,{engines=>st()->engine_stats(),rspamd_native=>st()->rspamd_native_stats(),auth=>st()->auth_stats(),tls=>st()->tls_stats(),dsn=>st()->dsn_stats(),viruses=>st()->top_viruses(20),rejects=>st()->top_reject_reasons(20)}); }
    if($path eq '/metrics'){ my $m=st()->stats(); my @k=qw(messages delivered bounced deferred rejected smtp_rejected dnsbl_rejected spam_detected spam_rejected spam_delivered virus_detected dsn_events auth_success auth_failures tls_connections inbound outbound internal relay unknown); my $body="# HELP sendmailanalyzer_messages Mail flow counters from SendmailAnalyzer 10\n# TYPE sendmailanalyzer_messages gauge\n"; $body.="sendmailanalyzer_$_ ".(0+($m->{$_}||0))."\n" for @k; return [200,headers('text/plain; version=0.0.4; charset=utf-8'),[$body]]; }

    if($path eq '/'){
        my $date=valid_date(substr($p->{date}||'',0,10)); my $period_scope=($p->{scope}||'') eq 'month'?'month':'day'; my $hour=substr($p->{hour}||'',0,2); $hour='' if $period_scope eq 'month' || $hour !~ /^(?:[01]\d|2[0-3])$/;
        my($from,$to,$scope_label,$series_flows,$xkey,$layout_title);
        if($period_scope eq 'month'){
            my($y,$m)=split /-/,$date; my $dim=days_in_month($date); $date=sprintf('%04d-%02d-01',$y,$m); $from=$date.'T00:00:00'; $to=sprintf('%04d-%02d-%02dT23:59:59.999999',$y,$m,$dim); $scope_label=month_name($m).' '.$y.' · Full month'; $series_flows=st()->month_daily_flow_series(sprintf('%04d-%02d',$y,$m)); $xkey='day'; $layout_title='Monthly report';
        } else {
            $from=$date.'T'.($hour ne ''?$hour.':00:00':'00:00:00'); $to=$date.'T'.($hour ne ''?$hour.':59:59.999999':'23:59:59.999999'); $scope_label=$date.' · '.($hour ne ''?'Hour '.$hour.':00–'.$hour.':59':'Full day'); $series_flows=st()->hourly_flow_series($date); $xkey='hour'; $layout_title='Daily report';
        }
        my $s=st()->stats_range($from,$to); my $flows=st()->flow_summary($from,$to); my $parties=st()->unique_party_counts($from,$to); my $recent=st()->recent_messages(from=>$from,to=>$to,limit=>12); my $tops=st()->top_senders(8,$from,$to); my $topr=st()->top_recipients(8,$from,$to);
        my $body='<div class="report-scope">'.h($scope_label).'</div>';
        $body.='<div class="classic-report-grid"><section class="classic-panel"><div class="classic-title">Message Flow</div><div class="classic-body">'.classic_flow_table($flows).'</div></section><section class="classic-panel"><div class="classic-title">Message Distribution</div><div class="classic-body">'.direction_distribution_table($flows).'</div></section></div>';
        $body.='<div class="classic-visual-grid mt"><section class="classic-graph-card"><h3>Message flow</h3>'.flow_line_chart($series_flows,$xkey).'</section><section class="classic-graph-card"><h3>Delivery Direction</h3>'.direction_donut($flows).'</section></div>';
        $body.='<div class="classic-visual-grid mt"><section class="classic-graph-card"><h3>Message Flow Size</h3>'.size_flow_line_chart($series_flows,$xkey).'</section><section class="classic-panel compact-panel"><div class="classic-title">Distinct senders/recipients</div><div class="classic-body">'.unique_parties_table($parties).'<div class="flow-cards mt"><div class="flow-card"><b>'.fmt($s->{delivered}).'</b><span>Deliveries</span></div><div class="flow-card"><b>'.fmt($s->{rejected}).'</b><span>Rejections</span></div><div class="flow-card"><b>'.fmt($s->{spam_detected}).'</b><span>Spam</span></div><div class="flow-card"><b>'.fmt($s->{virus_detected}).'</b><span>Virus</span></div></div></div></section></div>';
        $body.='<div class="classic-report-grid mt"><section class="classic-panel"><div class="classic-title">Top senders</div><div class="classic-body">'.top_table($tops,'sender','count',sub{my$r=shift;'delivered '.fmt($r->{delivered}).' · spam '.fmt($r->{spam})},'blue').'</div></section><section class="classic-panel"><div class="classic-title">Top recipients</div><div class="classic-body">'.top_table($topr,'recipient','count',sub{my$r=shift;'sent '.fmt($r->{sent})},'purple').'</div></section></div>';
        $body.='<section class="classic-panel mt"><div class="classic-title">Recent activity for the period</div><div class="classic-body">'.msg_table($recent,$prefix).'</div></section>';
        return html_response(200,layout($layout_title,$body,$prefix,'/',{date=>$date,hour=>$hour,scope=>$period_scope}));
    }
    if($path eq '/time/hour'){
        my $date=substr($p->{date}||strftime('%Y-%m-%d',localtime),0,10); $date=strftime('%Y-%m-%d',localtime) if $date !~ /^\d{4}-\d{2}-\d{2}$/; my $rows=st()->hourly_series($date); my $body=pagehead('Time','By hour','Distribution of messages, rejections and spam throughout the day.').'<section class="panel"><form class="period-form"><label>Date <input type="date" name="date" value="'.h($date).'"></label><button>View day</button></form></section><section class="panel mt">'.section_head('Hourly activity',$date).period_chart($rows,'hour','Activity by hour').'</section>'; return html_response(200,layout('By hour',$body,$prefix,'/time/hour'));
    }
    if($path eq '/time/day'){
        my $rows=st()->daily_series(31); my $body=pagehead('Time','By day','Last 31 days of activity.').'<section class="panel">'.section_head('Daily activity','Messages, rejections and detected spam').period_chart($rows,'day','Activity by day').'</section>'; return html_response(200,layout('By day',$body,$prefix,'/time/day'));
    }
    if($path eq '/time/month'){
        my $rows=st()->monthly_series(12); my $body=pagehead('Time','By month','Monthly activity for up to 12 months.').'<section class="panel">'.section_head('Monthly activity','Messages, rejections and detected spam').period_chart($rows,'month','Activity by month').'</section>'; return html_response(200,layout('By month',$body,$prefix,'/time/month'));
    }
    if($path eq '/messages'){
        my $q=substr($p->{q}||'',0,200); my $rows=st()->recent_messages(q=>$q,limit=>$cfg->{WEB_PAGE_SIZE}); my $body=pagehead('Mail','Messages','Queue-ID, Message-ID, sender or recipient.').'<section class="panel"><form class="searchbar"><input name="q" value="'.h($q).'" placeholder="Search"><button>Search</button></form></section><section class="panel mt">'.msg_table($rows,$prefix).'</section>'; return html_response(200,layout('Messages',$body,$prefix,'/messages'));
    }
    if($path =~ m{^/direction/(inbound|outbound|internal|relay|unknown)$}){
        my $dir=$1; my %name=(inbound=>'Inbound',outbound=>'Outbound',internal=>'Internal',relay=>'Relay',unknown=>'Unclassified'); my $rows=st()->recent_messages(direction=>$dir,limit=>$cfg->{WEB_PAGE_SIZE}); my $s=st()->stats(); my $body=pagehead('Mail',$name{$dir},'Latest messages classified as '.lc($name{$dir}).'.').'<div class="kpis">'.kpi($name{$dir},$s->{$dir}||0,'cumulative total',$dir eq 'outbound'?'purple':$dir eq 'internal'?'teal':'blue').'</div><section class="panel mt">'.msg_table($rows,$prefix).'</section>'; return html_response(200,layout($name{$dir},$body,$prefix,"/direction/$dir"));
    }
    if($path eq '/senders'){
        my $rows=st()->top_senders(40); my $body=pagehead('Mail','Senders','Cumulative sender ranking.').'<section class="panel">'.top_table($rows,'sender','count',sub{my$r=shift;'delivered '.fmt($r->{delivered}).' · spam '.fmt($r->{spam})},'blue').'</section>'; return html_response(200,layout('Senders',$body,$prefix,'/senders'));
    }
    if($path eq '/recipients'){
        my $rows=st()->top_recipients(40); my $body=pagehead('Mail','Recipients','Cumulative recipient ranking.').'<section class="panel">'.top_table($rows,'recipient','count',sub{my$r=shift;'sent '.fmt($r->{sent})},'purple').'</section>'; return html_response(200,layout('Recipients',$body,$prefix,'/recipients'));
    }
    if($path eq '/spam'){
        my $s=st()->stats(); my $series=st()->spam_daily_series(30); my $rows=st()->recent_messages(spam=>1,limit=>$cfg->{WEB_PAGE_SIZE}); my $body=pagehead('Security','Spam','Detection is tracked separately from final MTA disposition.').'<div class="kpis">'.kpi('Detected',$s->{spam_detected},'engines','amber').kpi('Rejected',$s->{spam_rejected},'blocked','red').kpi('Delivered',$s->{spam_delivered},'accepted','green').'</div><section class="panel mt">'.section_head('Spam · 30 days','Detected, rejected and delivered').spam_chart($series).'</section><section class="panel mt">'.section_head('Messages detected as spam','Latest cases').msg_table($rows,$prefix).'</section>'; return html_response(200,layout('Spam',$body,$prefix,'/spam'));
    }
    if($path eq '/viruses'){
        my $s=st()->stats(); my $v=st()->top_viruses(30); my $rows=st()->recent_messages(virus=>1,limit=>$cfg->{WEB_PAGE_SIZE}); my @tr=map{'<tr><td>'.h($_->{virus}).'</td><td>'.fmt($_->{count}).'</td></tr>'}@$v; my $body=pagehead('Security','Virus','Antivirus detections and associated messages.').'<div class="kpis">'.kpi('Detected',$s->{virus_detected},'total','red').'</div><div class="two mt"><section class="panel">'.section_head('Detections','Signature / status').simple_table(['Virus','Total'],\@tr).'</section><section class="panel"><div class="note">Clean messages are not shown here. Only antivirus states other than clean/ok are displayed.</div></section></div><section class="panel mt">'.msg_table($rows,$prefix).'</section>'; return html_response(200,layout('Virus',$body,$prefix,'/viruses'));
    }
    if($path eq '/rejects'){
        my $s=st()->stats(); my $rej=st()->top_reject_reasons(30); my $rows=st()->recent_messages(rejected=>1,limit=>$cfg->{WEB_PAGE_SIZE}); my @tr=map{'<tr><td>'.h($_->{type}).'</td><td class="sendercell">'.h($_->{reason}).'</td><td>'.fmt($_->{count}).'</td></tr>'}@$rej; my $body=pagehead('Security','Rejections','SMTP, DNSBL, milter and final-disposition decisions.').'<div class="kpis">'.kpi('Rejected',$s->{rejected},'messages','red').kpi('SMTP',$s->{smtp_rejected},'events','red').kpi('DNSBL',$s->{dnsbl_rejected},'Postscreen','purple').'</div><section class="panel mt">'.section_head('Top reasons','Rejection events').simple_table(['Type','Reason','Total'],\@tr).'</section><section class="panel mt">'.section_head('Rejected messages','Materialized records').msg_table($rows,$prefix).'</section>'; return html_response(200,layout('Rejections',$body,$prefix,'/rejects'));
    }
    if($path eq '/auth'){
        my $a=st()->auth_stats(); my($ok,$fail)=(0,0); for(@$a){$_->{success}?($ok+=$_->{count}||0):($fail+=$_->{count}||0)} my $meter=segmented_meter([{label=>'Successful',value=>$ok,kind=>'green'},{label=>'Failures',value=>$fail,kind=>'red'}]); my @tr=map{'<tr><td>'.h($_->{source}).'</td><td>'.h($_->{protocol}).'</td><td>'.h($_->{method}).'</td><td>'.($_->{success}?badge('OK','good'):badge('Failure','bad')).'</td><td>'.fmt($_->{count}).'</td></tr>'}@$a; my $body=pagehead('Security','Authentication','SMTP and Dovecot grouped by protocol and method.').'<div class="two"><section class="panel">'.section_head('Result','Successes versus failures').$meter.'</section><section class="panel"><div class="statlist"><div class="statbox"><div class="n">'.fmt($ok).'</div><div class="t">Successful</div></div><div class="statbox"><div class="n">'.fmt($fail).'</div><div class="t">Failures</div></div></div></section></div><section class="panel mt">'.simple_table(['Source','Protocol','Method','Result','Total'],\@tr).'</section>'; return html_response(200,layout('Authentication',$body,$prefix,'/auth'));
    }
    if($path eq '/tls'){
        my $t=st()->tls_stats(); my @parts; my @colors=qw(blue purple teal gray); my $i=0; for my $r(@$t){push @parts,{label=>($r->{direction}||'unknown').'/'.($r->{protocol}||'unknown'),value=>$r->{count}||0,kind=>$colors[$i++%@colors]}} my @tr=map{'<tr><td>'.h($_->{direction}).'</td><td>'.h($_->{protocol}).'</td><td>'.fmt($_->{count}).'</td></tr>'}@$t; my $body=pagehead('Security','TLS','Encrypted connections by direction and protocol version.').'<section class="panel">'.segmented_meter(\@parts).'</section><section class="panel mt">'.simple_table(['Direction','Protocol','Total'],\@tr).'</section>'; return html_response(200,layout('TLS',$body,$prefix,'/tls'));
    }
    if($path eq '/rspamd'){
        my $r=st()->rspamd_native_stats(); my $e=st()->engine_stats(); my $settings=top_table($r->{settings}||[],'settings_id','count',undef,'purple'); my $forced=top_table($r->{forced}||[],'forced_action','count',undef,'red'); my @actions=map{'<tr><td>'.h($_->{action}).'</td><td>'.fmt($_->{count}).'</td></tr>'}@{$e->{rspamd}||[]}; my $body=pagehead('Security','Rspamd','Native log: actions, settings and force_actions.').'<div class="kpis">'.kpi('Native scans',$r->{scans},'rspamd.log','purple').'</div><div class="two mt"><section class="panel">'.section_head('Settings','Applied profiles').$settings.'</section><section class="panel">'.section_head('Forced actions','Forced actions').$forced.'</section></div><section class="panel mt">'.section_head('Final actions','Per-message summary').simple_table(['Action','Total'],\@actions).'</section>'; return html_response(200,layout('Rspamd',$body,$prefix,'/rspamd'));
    }
    if($path eq '/dsn'){
        my $d=st()->dsn_stats(); my @tr=map{'<tr><td>'.h($_->{status}).'</td><td>'.fmt($_->{count}).'</td></tr>'}@$d; my $s=st()->stats(); my $body=pagehead('Messaging','Notifications / DSN','Recorded delivery-status notification states.').'<div class="kpis">'.kpi('DSN events',$s->{dsn_events},'cumulative','teal').'</div><section class="panel mt">'.simple_table(['Status','Total'],\@tr).'</section>'; return html_response(200,layout('Notifications / DSN',$body,$prefix,'/dsn'));
    }
    if($path eq '/status'){
        my $s=st()->stats(); my $flow=segmented_meter([{label=>'Inbound',value=>$s->{inbound}||0,kind=>'blue'},{label=>'Outbound',value=>$s->{outbound}||0,kind=>'purple'},{label=>'Internal',value=>$s->{internal}||0,kind=>'teal'},{label=>'Relay',value=>$s->{relay}||0,kind=>'gray'}]); my $body=pagehead('Messaging','Status / Flow','Cumulative traffic distribution and final status.').'<div class="kpis">'.kpi('Messages',$s->{messages},'total','blue').kpi('Deliveries',$s->{delivered},'recipients','green').kpi('Rejections',$s->{rejected},'messages','red').kpi('Deferred',$s->{deferred},'pending','amber').kpi('Bounced',$s->{bounced},'bounced','red').kpi('Relay',$s->{relay},'transit','teal').'</div><section class="panel mt">'.section_head('Flow direction','Cumulative distribution').$flow.'</section>'; return html_response(200,layout('Status / Flow',$body,$prefix,'/status'));
    }
    if($path eq '/security'){
        my $s=st()->stats(); my $body=pagehead('Security','Security overview','Direct access to each engine and control area.').'<div class="category-grid"><a class="category-card" href="'.h(u($prefix,'/spam')).'"><strong>Spam</strong><span>Detection, rejection and delivery</span><b>'.fmt($s->{spam_detected}).'</b></a><a class="category-card" href="'.h(u($prefix,'/viruses')).'"><strong>Virus</strong><span>Antivirus and signatures</span><b>'.fmt($s->{virus_detected}).'</b></a><a class="category-card" href="'.h(u($prefix,'/rejects')).'"><strong>Rejections</strong><span>SMTP, DNSBL and Milter</span><b>'.fmt($s->{rejected}).'</b></a><a class="category-card" href="'.h(u($prefix,'/auth')).'"><strong>Authentication</strong><span>SMTP / Dovecot</span><b>'.fmt($s->{auth_failures}).' failures</b></a><a class="category-card" href="'.h(u($prefix,'/tls')).'"><strong>TLS</strong><span>Versions and direction</span><b>'.fmt($s->{tls_connections}).'</b></a><a class="category-card" href="'.h(u($prefix,'/rspamd')).'"><strong>Rspamd</strong><span>Settings and force_actions</span><b>Details</b></a></div>'; return html_response(200,layout('Security',$body,$prefix,'/security'));
    }
    if($path =~ m{^/message/([A-Za-z0-9._-]+)$}){
        my $m=st()->message_detail($1); return html_response(404,layout('Not found',pagehead('Message','Not found','The requested Queue-ID does not exist.'),$prefix,'/messages')) if !$m; my($status,$kind)=msg_status($m); my $shown=$m->{display_queue_id}||$m->{queue_id}; my $rc=join '<br>',map{h($_->{recipient}).' '.badge($_->{status}||'','neutral')}@{$m->{recipients}}; my $events=join '',map{my$src=$_->{source}||'event';'<div class="event"><span class="event-dot"></span><div class="event-head">'.badge($src,'neutral').'<strong>'.h($_->{type}).'</strong><span class="event-time">'.h($_->{timestamp}).'</span></div>'.(defined($_->{raw})&&$_->{raw} ne ''?'<code>'.h($_->{raw}).'</code>':'').'</div>'}@{$m->{events}}; my $body='<section class="panel detail-hero"><div class="eyebrow">Correlated detail</div><h1>'.h($shown).'</h1><p>'.h($m->{message_id}||'No Message-ID').'</p><div>'.badge($status,$kind).' '.badge($m->{direction}||'unknown','blue').'</div></section><div class="info-grid mt"><section class="panel">'.section_head('Flow','Identity and deliveries').'<dl class="kv"><dt>Sender</dt><dd>'.h($m->{sender}).'</dd><dt>Recipients</dt><dd>'.$rc.'</dd><dt>Client</dt><dd>'.h(($m->{client_host}||'').' '.($m->{client_ip}||'')).'</dd><dt>Size</dt><dd>'.fmt($m->{size}).' bytes</dd><dt>Deliveries</dt><dd>'.fmt($m->{delivered_count}).'</dd><dt>Rejection reason</dt><dd>'.h($m->{reject_reason}||'—').'</dd></dl></section><section class="panel">'.section_head('Security','Engines').'<dl class="kv"><dt>Spam</dt><dd>'.($m->{spam_detected}?badge('detected','warn'):badge('no','good')).'</dd><dt>SpamAssassin</dt><dd>'.h(defined$m->{sa_score}?$m->{sa_score}:'—').'</dd><dt>Rspamd</dt><dd>'.h(($m->{rspamd_action}||'—').' '.(defined$m->{rspamd_score}?$m->{rspamd_score}:'')).'</dd><dt>DKIM</dt><dd>'.h($m->{dkim_result}||'—').'</dd><dt>DMARC</dt><dd>'.h($m->{dmarc_result}||'—').'</dd><dt>Antivirus</dt><dd>'.h($m->{av_status}||'—').'</dd></dl></section></div><section class="panel mt">'.section_head('Timeline','Correlated events').'<div class="timeline">'.$events.'</div></section>'; return html_response(200,layout('Message '.$shown,$body,$prefix,'/messages'));
    }
    return [404,headers('text/plain; charset=utf-8'),['Not found']];
};
no warnings 'void';
$app;
