use strict; use warnings; use Test::More; use File::Temp qw(tempdir); use File::Spec; use FindBin;
use lib "$FindBin::Bin/../lib"; BEGIN { eval { require DBI; require DBD::SQLite; 1 } or plan skip_all => 'DBI/SQLite unavailable'; } use SendmailAnalyzer::Storage::SQLite;
my $tmp=tempdir(CLEANUP=>1); my $mail=File::Spec->catfile($tmp,'mail.log'); my $rsp=File::Spec->catfile($tmp,'rspamd.log'); my $db=File::Spec->catfile($tmp,'x.sqlite');
open my $m,'>',$mail or die $!; print $m "Sep 15 10:00:00 mailhost postfix/cleanup[1]: ABC123: message-id=<m\@example.net>\n"; print $m "Sep 15 10:00:01 mailhost postfix/cleanup[1]: ABC123: milter-header-add: header X-Rspamd-Action: no action from mx.example[192.0.2.1]; from=<a\@example.net> to=<u\@example.test>\n"; print $m "Sep 15 10:00:02 mailhost postfix/qmgr[1]: ABC123: from=<a\@example.net>, size=123, nrcpt=1 (queue active)\n"; print $m "Sep 15 10:00:03 mailhost postfix/lmtp[1]: ABC123: to=<u\@example.test>, relay=mailhost[private/dovecot-lmtp], dsn=2.0.0, status=sent (250 Saved)\n"; close $m;
open my $r,'>',$rsp or die $!; print $r '2026-09-15 10:00:01 #2(rspamd_proxy) <task>; proxy; rspamd_task_write_log: id: <m@example.net>, qid: <ABC123>, ip: 192.0.2.1, from: <a@example.net>, (default: T (no action): [-2.00/16.00] [BAYES_HAM(-3.00){100.00%;}]), len: 123, time: 25.000ms, dns req: 2, digest: <abcd>, rcpts: <u@example.test>, mime_rcpts: <u@example.test>, settings_id: DEFAULT' . "\n"; close $r;
my $script="$FindBin::Bin/../bin/sa10_collect"; my $rc=system($^X,$script,'--replay','--year','2026','--db',$db,'--log',$mail,'--log',$rsp); is($rc,0,'dual source replay exits cleanly');
my $s=SendmailAnalyzer::Storage::SQLite->new(file=>$db,readonly=>1); my $row=$s->dbh->selectrow_hashref('SELECT * FROM messages WHERE queue_id=?',undef,'ABC123'); ok($row,'message created'); is($row->{rspamd_action},'no action','single message action'); is($row->{rspamd_score},-2,'native score enriched'); is($row->{delivered_count},1,'delivery not duplicated');
my ($rv)=$s->dbh->selectrow_array("SELECT COUNT(*) FROM events WHERE queue_id='ABC123' AND source='rspamd' AND type='verdict'"); is($rv,2,'native and header evidence both retained');
my $detail=$s->message_detail('ABC123'); my @native=grep { ($_->{data}{evidence}||'') eq 'rspamd.log' } @{$detail->{events}}; is(scalar @native,1,'one native rich event'); is($native[0]{data}{dns_requests},2,'native fields retained in JSON');
done_testing;
