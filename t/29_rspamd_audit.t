use strict; use warnings; use Test::More; use File::Temp qw(tempdir); use FindBin;
my $tmp=tempdir(CLEANUP=>1); my $mail="$tmp/mail.log"; my $rsp="$tmp/rspamd.log";
open my $m,'>',$mail or die $!; print $m "Sep 15 10:00:00 mailhost postfix/cleanup[1]: ABC123: message-id=<m\@example.net>\n"; print $m "Sep 15 10:00:01 mailhost postfix/cleanup[1]: ABC123: milter-header-add: header X-Rspamd-Action: no action from mx[192.0.2.1]; from=<a\@x> to=<u\@example.test>\n"; print $m "Sep 15 10:00:01 mailhost postfix/cleanup[1]: ABC123: milter-header-add: header X-Spamd-Result: default: False [-2.00 / 16.00] [BAYES_HAM(-3.00)] from mx[192.0.2.1]; from=<a\@x> to=<u\@example.test>\n"; close $m;
open my $r,'>',$rsp or die $!; print $r "2026-09-15 10:00:01 #2(rspamd_proxy) <task>; proxy; rspamd_task_write_log: id: <m\@example.net>, qid: <ABC123>, ip: 192.0.2.1, from: <a\@x>, (default: T (no action): [-2.00/16.00] [BAYES_HAM(-3.00){}]), len: 123, time: 25.000ms, dns req: 2, digest: <abcd>, rcpts: <u\@example.test>\n"; close $r;
my $script="$FindBin::Bin/../bin/sa10_rspamd_audit"; my $out=`$^X $script --year 2026 --mail $mail --rspamd $rsp --strict 2>&1`; is($? >> 8,0,'audit exits PASS'); like($out,qr/matched_queue_ids=1 unmatched_queue_ids=0/,'qid matched'); like($out,qr/message_id compared=1 mismatches=0/,'mid matches'); like($out,qr/action compared=1 mismatches=0/,'action matches'); like($out,qr/score compared=1 mismatches=0/,'score matches'); like($out,qr/RESULT: PASS/,'pass result');
done_testing;
