[Unit]
Description=SendmailAnalyzer 10 read-only web interface
After=network.target sendmailanalyzer-collector.service

[Service]
Type=simple
User=sendmailanalyzer
Group=sendmailanalyzer
ExecStart=/usr/bin/sa10_web --config /etc/sendmailanalyzer.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/sendmailanalyzer
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
