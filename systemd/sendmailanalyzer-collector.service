[Unit]
Description=SendmailAnalyzer 10 mail log collector
After=local-fs.target rsyslog.service
Wants=rsyslog.service

[Service]
Type=simple
User=sendmailanalyzer
Group=sendmailanalyzer
SupplementaryGroups=adm
ExecStart=/usr/bin/sa10_collect --config /etc/sendmailanalyzer.conf --follow
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sendmailanalyzer
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
